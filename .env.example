# Resend API key (https://resend.com/api-keys)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# Where alerts get sent
ALERT_EMAIL_TO=o.wyatt@wustl.edu

# Sender. Resend's shared test sender only delivers to the address you
# signed up with. Swap this once you verify your own domain.
ALERT_EMAIL_FROM=Job Alerter <onboarding@resend.dev>

# How often to poll, in minutes
POLL_INTERVAL_MINUTES=20

# Where the "already alerted" database lives.
# Local default is ./data ; on Railway point this at your mounted volume.
DATA_DIR=./data
